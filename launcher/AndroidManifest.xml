<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.beeshtv.home"
    android:versionCode="11"
    android:versionName="3.0">

    <!-- Wallpapers from wallhaven.cc and weather from open-meteo.com. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi panel: network name, signal and nearby networks (Android ties these to location). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Uninstall from an app's menu (the system still asks to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Installs new releases from GitHub (the system still asks to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Bluetooth panel: paired devices and whether they are connected (asked for in setup). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
        <!-- The other BEESH TV Suite apps, to tell which are installed (see Suite). -->
        <package android:name="com.beeshtv.browser" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <!-- Stock home screens, to tell whether they'd take the Home button back (HomeGuard). -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.google.android.leanbacklauncher" />
    </queries>

    <application
        android:label="BEESH Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- An icon in the TV's app list, so a sideloaded APK can be opened to finish setup. -->
        <activity-alias
            android:name=".Setup"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Keeps the Home button on BeeshTV while Google TV's own home screen is enabled. -->
        <service
            android:name=".HomeGuard"
            android:label="@string/home_guard_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_guard" />
        </service>

        <!-- The system installer's answer when an update is installed (see Updater). -->
        <receiver
            android:name=".Updater$InstallStatus"
            android:exported="false" />

        <!-- Shares the photo on Home and the weather, read-only, with BEESH Browser. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.beeshtv.home.share"
            android:exported="true" />

        <!-- Lists and clears notifications for the bell in the menu bar, once access is granted. -->
        <service
            android:name=".NotificationsService"
            android:label="BEESH Launcher"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
